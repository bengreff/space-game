// Resource Definitions

(
    resources: [
        (
            id: "propellant",
            name: "Propellant",
            description: "Liquid fuel and oxidizer mixture for rocket engines",
            unit: "units",
            density: 0.005,  // tonnes per unit
            color: (0.9, 0.5, 0.1),  // Orange
            transferable: true,
        ),

        (
            id: "electric_charge",
            name: "Electric Charge",
            description: "Electrical energy for systems",
            unit: "EC",
            density: 0.0,  // Massless
            color: (0.3, 0.7, 1.0),  // Light blue
            transferable: true,
        ),

        (
            id: "life_support",
            name: "Life Support",
            description: "Supplies to keep crew alive",
            unit: "units",
            density: 0.001,
            color: (0.2, 0.8, 0.2),  // Green
            transferable: true,

            // Consumption rate per crew per second
            consumption_rate: 0.0001,
        ),

        (
            id: "ore",
            name: "Ore",
            description: "Raw material extracted from celestial bodies",
            unit: "units",
            density: 0.01,
            color: (0.5, 0.4, 0.3),  // Brown
            transferable: true,
        ),

        (
            id: "solid_fuel",
            name: "Solid Fuel",
            description: "Solid propellant for SRBs. Cannot be transferred.",
            unit: "units",
            density: 0.0075,
            color: (0.4, 0.4, 0.4),  // Gray
            transferable: false,  // Cannot transfer between parts
        ),
    ],

    // Resource conversions (for colonies)
    conversions: [
        (
            id: "ore_to_propellant",
            name: "Ore Processing",
            input: { "ore": 10.0 },
            output: { "propellant": 9.0 },
            rate: 0.1,  // Conversions per second at 100% efficiency
        ),
    ],
)
