        // Inertial confinement D+He3 fusion, first stage
        // ============================================

        (
            id: "engine_daedalus_s1",
            name: "Daedalus Stage 1",
            description: "Massive inertial confinement fusion engine based on the Project Daedalus study. Electron beams ignite D+He3 fuel pellets at 250 per second, expelling fusion plasma at 10,000 km/s. Designed as a first-stage booster for interstellar flyby probes. The magnetic nozzle alone masses more than most spacecraft.",
            category: Interstellar,
            mass: 4500.0,
            cost: 8000000,
            size: XL,
