// Interstellar Engine Definitions
// Eight engines across three technology tiers: Nuclear Pulse, Fusion, Antimatter.
// All vacuum-only (no atmospheric thrust). Massive Isp values for interstellar delta-v.
// Thrust in kN. Isp = exhaust_velocity(m/s) / 9.80665.

(
    parts: [
        // ============================================
        // NUCLEAR PULSE — Orion Pulse Drive
        // Propelled by sequential nuclear detonations
        // ============================================

        (
            id: "engine_orion_pulse",
            name: "Orion Pulse Drive",
            description: "Nuclear pulse propulsion system. A massive pusher plate absorbs the force of sequential nuclear detonations, each launching a shaped-charge fission bomb behind the ship. Brutal thrust, moderate efficiency. The only interstellar drive you can build with 1960s technology — if you don't mind the fallout.",
            category: Interstellar,
            mass: 7000.0,
            cost: 5000000,
            size: XL,
            shape: Trapezoid,
            grid_width: 70.0,
            grid_height: 52.0,
            top_width: Some(30.0),
            hitbox_width: Some(71),
            engine: Some((
                thrust_vac: 60000.0,
                thrust_asl: 0.0,
                isp_vac: 4079.0,
                isp_asl: 0.0,
                throttleable: false,
                gimbal_range: 0.0,
                propellant: NuclearPulse,
                alternator_power: 50000000.0,
            )),
            resources: {},
        ),

        // ============================================
