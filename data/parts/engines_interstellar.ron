        // ============================================

        (
            id: "engine_gamma_conversion",
            name: "Gamma Converter",
            description: "Gamma-ray photon drive. Matter-antimatter annihilation produces gamma rays focused into a coherent beam by a crystalline gamma-ray lens. Exhaust velocity approaches 255,000 km/s — 85% of lightspeed. Absurdly efficient but thrust-limited by the annihilation rate. For missions measured in fractions of c.",
