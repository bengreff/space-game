        // Compact Z-pinch fusion for probes
        // ============================================

        (
            id: "engine_zpinch_probe",
            name: "Z-Pinch Probe",
            description: "Compact Z-pinch fusion drive for unmanned interstellar probes. Powerful electrical current compresses a D+He3 plasma filament to fusion conditions, expelling exhaust at 8,000 km/s. Small enough for robotic precursor missions. The magnetic nozzle doubles as a deceleration brake.",
