        (
            id: "engine_daedalus_s2",
            name: "Daedalus Stage 2",
            description: "Compact second-stage variant of the Daedalus fusion drive. Same inertial confinement principle at reduced scale — lower pellet injection rate trades thrust for structural savings. Optimized for cruise acceleration after the first stage separates.",
            category: Interstellar,
